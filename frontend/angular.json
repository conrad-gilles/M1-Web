{
    "version": 1,
    "projects": {
        "sharing-platform": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.app.json",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "ffmpeg-core.{js,wasm}",
                                "input": "node_modules/@ffmpeg/core/dist/esm",
                                "output": "ffmpeg"
                            },
                            {
                                "glob": "{worker,const,errors}.js",
                                "input": "node_modules/@ffmpeg/ffmpeg/dist/esm",
                                "output": "ffmpeg"
                            }
                        ],
                        "styles": [
                            "src/styles.css",
                            "src/material-theme.scss"
                        ]
                    }
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "development": {
                            "buildTarget": "sharing-platform:build"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "buildTarget": "sharing-platform:build",
                        "tsConfig": "tsconfig.spec.json",
                        "setupFiles": ["src/test-setup.ts"]
                    }
                }
            }
        }
    },
    "cli": {
      "analytics": "31a898bc-fdde-4ab5-8551-7549124d3bfc"
    }
}