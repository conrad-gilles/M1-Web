MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/guitar-practice-cloud?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-local-secret
PORT=3000

# Facultatif. Heures d'inactivité avant l'expiration d'un salon (24 par défaut).
# ROOM_TTL_HOURS=24
# Facultatif. Durée de validité d'une URL de lecture, en secondes (21600 = 6 h).
# MEDIA_URL_TTL_SECONDS=21600
# Facultatif. Nombre de proxys de confiance devant l'API (1 sur Render).
# TRUST_PROXY=1
# Facultatif. Origines autorisées si le frontend est hébergé ailleurs,
# séparées par des virgules. Vide : même origine uniquement.
# CORS_ORIGIN=https://example.github.io
